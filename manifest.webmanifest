{
  "name": "Lando's World",
  "short_name": "Lando",
  "id": "/landos-world/",
  "description": "Lando's World is a personal application ecosystem with Digital Clock, Weather, Daily Chief Briefing, Violet Sprints, Death on Notecards, and Lee-Lee's Tracker.",
  "start_url": "/landos-world/",
  "scope": "/landos-world/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/landos-world/icons/landos-world-192-v2.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/landos-world/icons/landos-world-512-v2.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/landos-world/icons/landos-world-maskable-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Weather",
      "short_name": "Weather",
      "description": "Open the Lando's World weather app.",
      "url": "/landos-world/#/weather",
      "icons": [
        {
          "src": "/landos-world/icons/weather.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Digital Clock",
      "short_name": "Clock",
      "description": "Open Digital Clock.",
      "url": "/landos-world/#/digital-clock",
      "icons": [
        {
          "src": "/landos-world/icons/digital-clock.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lee-Lee's Tracker",
      "short_name": "Tracker",
      "description": "Open Lee-Lee's Tracker.",
      "url": "/landos-world/#/lee-lees-tracker",
      "icons": [
        {
          "src": "/landos-world/icons/lee-lees-tracker.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Violet Sprints",
      "short_name": "Sprints",
      "description": "Open Violet Sprints interval timer.",
      "url": "/landos-world/#/violet-sprints",
      "icons": [
        {
          "src": "/landos-world/icons/violet-sprints.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
